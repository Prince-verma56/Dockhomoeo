# Database configuration (PostgreSQL container)
DATABASE_URL=postgres://dochomoeo:password@127.0.0.1:5433/dochomoeo_v2
LEGACY_DATABASE_URL=postgres://dochomoeo:password@127.0.0.1:5433/dochomoeo
LEGACY_MONGODB_URI=

PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-characters-random-secret

# Seed Admin User
SEED_ADMIN_EMAIL=admin@dochomoeo.local
SEED_ADMIN_PASSWORD=change-me-secure-password

# ── Sign-in codes (OTP) ─────────────────────────────────────────────────────
# OTP mode: "live" uses actual MSG91 SMS delivery; "mock" or "demo" uses local test code
OTP_MODE=live
# Leave empty for live SMS mode; specify a 6-digit code only for local mock demo testing
OTP_DEV_CODE=
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_dlt_template_flow_id_here

# Email SMTP (Brevo or Gmail App Password)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login
SMTP_PASS=your_smtp_password
MAIL_FROM=DocHomoeo <care@dochomoeo.com>

# ── Payment gateway (PhonePe) ───────────────────────────────────────────────
# For test/sandbox: PGTESTPAYUAT86 / 96434309-7796-489d-8924-ab56988a6076 / index 1 / sandbox
# For production: your live MID and salt key from PhonePe dashboard
PHONEPE_MERCHANT_ID=PGTESTPAYUAT86
PHONEPE_SALT_KEY=96434309-7796-489d-8924-ab56988a6076
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox
PUBLIC_API_URL=

# ── Courier & Logistics (Shiprocket) ────────────────────────────────────────
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_WEBHOOK_TOKEN=your_shiprocket_webhook_secret

# Test mode flags
PAYMENTS_TEST_MODE=false
SHIPPING_TEST_MODE=false
NODE_ENV=development
